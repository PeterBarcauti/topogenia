<!-- Desktop.pubxml -->
<!-- Publication of the desktop mode (spec 6.1, ADR 049, ADR 071): one self-contained executable for win-x64, its native libraries beside it (never extracted under %TEMP%), the interface in wwwroot -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- ADR 076: the assemblies stored as they are, never compressed in the executable then unpacked in memory at its start,
         which antivirus heuristics read as the mark of a packer -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- No module of IIS, no symbol of the projects referenced: the desktop mode runs its own server -->
    <PublishIISAssets>false</PublishIISAssets>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)../../../../artifacts/desktop/</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- The web.config of IIS is for the server mode alone -->
    <Content Update="web.config" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
