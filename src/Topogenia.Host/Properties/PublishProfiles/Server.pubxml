<!-- Server.pubxml -->
<!-- Publication of the server mode (spec 6.2, ADR 072): for IIS on Windows x64 with the Hosting Bundle of .NET 10, the web.config of the module of ASP.NET Core, the interface in wwwroot -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)../../../../artifacts/server/</PublishDir>
  </PropertyGroup>
</Project>
