<!-- web.config -->
<!-- IIS for the server mode (spec 6.2, ADR 072): the module of ASP.NET Core (completed at the publication), the largest request the host takes (a package of 100 MiB, ExchangeApi.PackageLimit, and 1 MiB of envelope), no header that names the server -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="105906176" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
