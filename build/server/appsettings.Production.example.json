// appsettings.Production.example.json
// The settings of the server mode (spec 6.2, ADR 072): to copy as appsettings.Production.json beside {{PRODUCT}}.dll, then to adapt (exploitation-serveur.md). Every value here is an example; build/package.mjs writes the name of the product for {{PRODUCT}} (D13).
{
  "{{PRODUCT}}": {
    "Mode": "Server",
    "Database": {
      "Provider": "SqlServer",
      // The account of the application pool connects by Windows authentication: no password in this file (spec 5.1).
      "ConnectionString": "Server=SQL-EXEMPLE;Database={{PRODUCT}};Integrated Security=true;Encrypt=true",
      "MigrationTimeoutMinutes": 10
    },
    "Server": {
      // The names the server answers to, without "*" (A-4-19): the name of the site and, for a check on the server, localhost.
      "AllowedHosts": [ "{{product}}.exemple.local" ],
      "LogsFolder": "D:\\Journaux\\{{PRODUCT}}"
    },
    // The logins of the administrators (read again at each change of this file, spec 5.3).
    "Administrators": [ "EXEMPLE\\admin.cartographie" ],
    "Languages": {
      "Supported": [ "fr", "en" ],
      "Default": "fr",
      "FirstLaneNames": { "fr": "Acteur 1", "en": "Actor 1" }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
