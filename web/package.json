{
  "name": "web",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "tokens": "node scripts/generate-tokens.mjs",
    "api": "node scripts/generate-api.mjs",
    "mockup": "node scripts/build-mockup.mjs && node scripts/capture-mockup.mjs",
    "demonstration": "npm run build && playwright test -c scripts/demonstration/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@xyflow/react": "12.12.0",
    "exceljs": "4.4.0",
    "html-to-image": "1.11.11",
    "i18next": "26.4.3",
    "inter-font": "3.19.0",
    "jspdf": "4.2.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.16",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
