# .editorconfig
# Code style shared by every editor and enforced at build time
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{bat,cmd}]
end_of_line = crlf

[*.{json,ts,tsx,css,html,mjs,yml,yaml}]
indent_size = 2

[*.cs]
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = when_multiline:silent
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_style_namespace_match_folder = true
dotnet_diagnostic.IDE0130.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning
dotnet_diagnostic.CA1823.severity = warning
dotnet_diagnostic.CA1812.severity = warning
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1310.severity = warning
dotnet_diagnostic.CA1307.severity = warning
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1707.severity = none

# EF Core migrations are generated, reviewed, then never changed (spec 4.4): analysed as generated code
[src/Topogenia.Persistence.{SqlServer,Sqlite}/Migrations/**.cs]
generated_code = true
