<!-- Topogenia.Interchange.Tests.csproj -->
<!-- Format, schema, round-trip and format upgrade tests of the exchange package and of the .pmap files -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- The published schemas and the samples are read where they live, whatever the output folder (artifacts path) -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryRoot</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../..</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Topogenia.Interchange/Topogenia.Interchange.csproj" />
    <ProjectReference Include="../../src/Topogenia.Persistence.SqlServer/Topogenia.Persistence.SqlServer.csproj" />
    <ProjectReference Include="../../src/Topogenia.Persistence.Sqlite/Topogenia.Persistence.Sqlite.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
