<!-- Directory.Build.props -->
<!-- Common build settings of every project: target, nullable, warnings as errors, analysers, single version -->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>3.0.0</Version>
    <!-- D13: the product name is read from the single C# constant, never written here -->
    <ProductIdentityFile>$(MSBuildThisFileDirectory)src/Topogenia.Application/ProductIdentity.cs</ProductIdentityFile>
    <ProductName>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText($(ProductIdentityFile))), 'Name = "([^"]+)"').Groups[1].Value)</ProductName>
    <Company>$(ProductName)</Company>
    <Product>$(ProductName)</Product>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>
  <!-- ADR 048, ADR 074: the core (the domain) is its source project where its folder is, the Topogenia.Core package
       elsewhere (the public repository), restored from the folder CoreFeed -->
  <PropertyGroup>
    <CoreProject>$(MSBuildThisFileDirectory)src/Topogenia.Domain/Topogenia.Domain.csproj</CoreProject>
    <UseCorePackage Condition="'$(UseCorePackage)' == '' And Exists('$(CoreProject)')">false</UseCorePackage>
    <UseCorePackage Condition="'$(UseCorePackage)' == ''">true</UseCorePackage>
    <CoreFeed Condition="'$(CoreFeed)' == ''">$(MSBuildThisFileDirectory)artifacts/core-feed</CoreFeed>
    <RestoreAdditionalProjectSources Condition="'$(UseCorePackage)' == 'true'">$(RestoreAdditionalProjectSources);$(CoreFeed)</RestoreAdditionalProjectSources>
  </PropertyGroup>
</Project>
